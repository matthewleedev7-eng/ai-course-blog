---
interface Props {
  id: string;
  course: {
    title: string;
    description: string;
    provider: string;
    url: string;
    level: string;
    duration: string;
    language: string;
    hasCertificate: boolean;
    tags: string[];
    isFree: boolean;
    featured?: boolean;
    rating?: number;
    badge?: string;
  };
}

const { id, course } = Astro.props;

// 플랫폼별 색상 테마
const providerThemes: Record<string, { bg: string; text: string; border: string }> = {
  "OpenAI": { bg: "bg-emerald-500/10 dark:bg-emerald-500/20", text: "text-emerald-700 dark:text-emerald-300", border: "border-emerald-500/30" },
  "Anthropic": { bg: "bg-amber-600/10 dark:bg-amber-600/20", text: "text-amber-700 dark:text-amber-300", border: "border-amber-600/30" },
  "Google": { bg: "bg-blue-500/10 dark:bg-blue-500/20", text: "text-blue-700 dark:text-blue-300", border: "border-blue-500/30" },
  "DeepLearning.AI": { bg: "bg-rose-500/10 dark:bg-rose-500/20", text: "text-rose-700 dark:text-rose-300", border: "border-rose-500/30" },
  "Microsoft": { bg: "bg-sky-500/10 dark:bg-sky-500/20", text: "text-sky-700 dark:text-sky-300", border: "border-sky-500/30" },
  "Hugging Face": { bg: "bg-yellow-500/10 dark:bg-yellow-500/20", text: "text-yellow-700 dark:text-yellow-300", border: "border-yellow-500/30" },
  "Fast.ai": { bg: "bg-indigo-500/10 dark:bg-indigo-500/20", text: "text-indigo-700 dark:text-indigo-300", border: "border-indigo-500/30" },
  "Kaggle": { bg: "bg-cyan-500/10 dark:bg-cyan-500/20", text: "text-cyan-700 dark:text-cyan-300", border: "border-cyan-500/30" },
  "YouTube": { bg: "bg-red-500/10 dark:bg-red-500/20", text: "text-red-700 dark:text-red-300", border: "border-red-500/30" },
};

const defaultTheme = { bg: "bg-purple-500/10", text: "text-purple-700 dark:text-purple-300", border: "border-purple-500/30" };
const theme = providerThemes[course.provider] || defaultTheme;
---

<div 
  class="course-card group relative flex flex-col justify-between rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
  data-provider={course.provider}
  data-level={course.level}
  data-certificate={course.hasCertificate ? "true" : "false"}
  data-tags={course.tags.join(",")}
  data-search={`${course.title} ${course.description} ${course.provider} ${course.tags.join(" ")}`.toLowerCase()}
>
  <div>
    <!-- 상단 뱃지 영역 -->
    <div class="flex items-center justify-between gap-2 mb-3">
      <div class="flex items-center gap-1.5 flex-wrap">
        <span class={`px-2.5 py-1 text-xs font-semibold rounded-lg border ${theme.bg} ${theme.text} ${theme.border}`}>
          {course.provider}
        </span>
        {course.badge && (
          <span class="px-2 py-0.5 text-[11px] font-medium rounded-md bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
            ★ {course.badge}
          </span>
        )}
      </div>

      <div class="flex items-center gap-1 text-xs font-bold text-amber-500">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        <span>{course.rating ?? 4.9}</span>
      </div>
    </div>

    <!-- 제목 -->
    <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2 leading-snug">
      <a href={`/courses/${id}`}>
        {course.title}
      </a>
    </h3>

    <!-- 간략 설명 -->
    <p class="mt-2.5 text-sm text-slate-600 dark:text-slate-400 line-clamp-3 leading-relaxed">
      {course.description}
    </p>

    <!-- 메타 정보 (난이도, 시간, 수료증) -->
    <div class="mt-4 flex flex-wrap items-center gap-y-2 gap-x-3 text-xs text-slate-500 dark:text-slate-400 pt-3 border-t border-slate-100 dark:border-slate-800/80">
      <span class="inline-flex items-center gap-1 font-medium">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
        난이도: <strong class="text-slate-700 dark:text-slate-300">{course.level}</strong>
      </span>
      <span class="inline-flex items-center gap-1">
        ⏱ {course.duration}
      </span>
      {course.hasCertificate && (
        <span class="inline-flex items-center gap-1 text-emerald-600 dark:text-emerald-400 font-medium">
          🎓 수료증/뱃지
        </span>
      )}
    </div>

    <!-- 태그 목록 -->
    <div class="mt-3 flex flex-wrap gap-1.5">
      {course.tags.map((tag) => (
        <span class="tag-pill text-[11px] px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 cursor-pointer hover:bg-blue-50 dark:hover:bg-blue-900/30 hover:text-blue-600 transition-colors">
          #{tag}
        </span>
      ))}
    </div>
  </div>

  <!-- 하단 액션 버튼 -->
  <div class="mt-5 pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between gap-2">
    <a 
      href={`/courses/${id}`}
      class="inline-flex items-center text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
    >
      상세 가이드 보기
      <svg class="w-3.5 h-3.5 ml-1 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>

    <a 
      href={course.url} 
      target="_blank" 
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm hover:shadow transition-all"
    >
      강의 바로가기
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>
  </div>
</div>
