---
interface Props {
  slotId?: string;
  format?: 'auto' | 'horizontal' | 'rectangle' | 'in-article';
  client?: string;
  className?: string;
}

const {
  slotId = "1234567890",
  format = "auto",
  client = "ca-pub-2773225131688341",
  className = ""
} = Astro.props;

// 심사 기간 동안에는 사이트 완성도를 높이기 위해 안내 플레이스홀더를 노출하지 않음
// 승인 완료 후 수동 광고를 띄우고 싶을 때 true로 전환
const isAdEnabled = false;
---

{isAdEnabled && (
  <div class={`adsense-wrapper my-6 overflow-hidden rounded-xl text-center transition-all ${className}`}>
    <ins class="adsbygoogle"
         style="display:block"
         data-ad-client={client}
         data-ad-slot={slotId}
         data-ad-format={format}
         data-full-width-responsive="true"></ins>
    <script is:inline>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>
)}
