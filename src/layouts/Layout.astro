---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: 'ko' | 'en' | 'es' | 'pt';
}

const {
  title,
  image = "/og-image.png",
  lang = "ko",
} = Astro.props;

const isEn = lang === 'en';
const isEs = lang === 'es';
const isPt = lang === 'pt';
const isKo = !isEn && !isEs && !isPt;

const defaultDescription = isPt
  ? "Cursos e tutoriais oficiais e gratuitos de IA da OpenAI, Google, DeepLearning.AI e Harvard, selecionados para autodidatas."
  : isEs
  ? "Cursos y tutoriales oficiales y gratuitos de IA de OpenAI, Google, DeepLearning.AI y Harvard, seleccionados para autodidactas."
  : isEn
  ? "Handpicked free AI courses and official tutorials from OpenAI, Google, DeepLearning.AI, and Harvard, curated for self-learners."
  : "OpenAI, Google, DeepLearning.AI 등 글로벌 공식 무료 AI 강의 및 튜토리얼을 엄선하여 한국어로 정리한 AI 교육 큐레이션 블로그입니다.";

const description = Astro.props.description || defaultDescription;

const siteName = isPt
  ? "AI Learning Log | Cursos Gratuitos de IA"
  : isEs 
  ? "AI Learning Log | Cursos Gratuitos de IA" 
  : isEn 
  ? "AI Learning Log | Curated Free AI Courses" 
  : "AI 러닝로그 | 무료 AI 강의 & 독학 가이드";

const siteBase = "https://matthewlee-ailog.com";
const canonicalURL = new URL(Astro.url.pathname, siteBase);

// 다국어 URL 계산 (접두사 /en, /es, /pt 제거 후 각 언어별 클린 경로 매핑)
let cleanPath = Astro.url.pathname.replace(/^\/(en|es|pt)(\/|$)/, '/');
if (!cleanPath.startsWith('/')) cleanPath = '/' + cleanPath;

const koPath = cleanPath;
const enPath = cleanPath === '/' ? '/en' : `/en${cleanPath}`;
const esPath = cleanPath === '/' ? '/es' : `/es${cleanPath}`;
const ptPath = cleanPath === '/' ? '/pt' : `/pt${cleanPath}`;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- 다국어 SEO (hreflang) 태그 -->
    <link rel="alternate" hreflang="ko" href={`${siteBase}/`} />
    <link rel="alternate" hreflang="en" href={`${siteBase}/en/`} />
    <link rel="alternate" hreflang="es" href={`${siteBase}/es/`} />
    <link rel="alternate" hreflang="pt" href={`${siteBase}/pt/`} />
    <link rel="alternate" hreflang="x-default" href={`${siteBase}/`} />

    <!-- Open Graph / SNS 공유 최적화 -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${siteName}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Pretendard Web Font -->
    <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />

    <!-- 구글 애드센스 공식 스크립트 및 계정 인증 메타태그 (퍼블리셔 ID: ca-pub-2773225131688341) -->
    <meta name="google-adsense-account" content="ca-pub-2773225131688341" />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2773225131688341"
     crossorigin="anonymous"></script>

    <!-- 구글 애널리틱스 (GA4) 공식 추적 태그 (측정 ID: G-0RG3XQTJ9C) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-0RG3XQTJ9C"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-0RG3XQTJ9C');
    </script>

    <!-- 테마 초기화 스크립트 -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>

    <style>
      body {
        font-family: "Pretendard", -apple-system, BlinkMacSystemFont, system-ui, Roboto, "Helvetica Neue", "Segoe UI", "Apple SD Gothic Neo", "Noto Sans KR", "Malgun Gothic", sans-serif;
      }
    </style>
  </head>
  <body class="bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-200 min-h-screen flex flex-col antialiased selection:bg-blue-500 selection:text-white transition-colors duration-200">
    <!-- 헤더 내비게이션 -->
    <header class="sticky top-0 z-50 w-full backdrop-blur-md bg-white/90 dark:bg-slate-950/90 border-b border-slate-200 dark:border-slate-800 shadow-xs">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <!-- 로고 -->
        <a href={isPt ? "/pt" : isEs ? "/es" : isEn ? "/en" : "/"} class="flex items-center gap-2.5 group">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-500 flex items-center justify-center text-white shadow-md shadow-blue-500/20 group-hover:scale-105 transition-transform">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="font-extrabold text-base sm:text-lg tracking-tight text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              {isPt ? "AI Learning Log" : isEs ? "AI Learning Log" : isEn ? "AI Learning Log" : "AI 러닝로그"}
            </span>
            <span class="text-[10px] font-medium text-slate-400 -mt-0.5 tracking-wider">
              {isPt ? "Cursos Gratuitos de IA" : isEs ? "Cursos Gratuitos de IA" : isEn ? "Handpicked Free AI Courses" : "나만 알기 아까운 무료 AI 강의"}
            </span>
          </div>
        </a>

        <!-- 내비게이션 메뉴 & 4개국어 전환 & 다크모드 버튼 -->
        <div class="flex items-center gap-2 sm:gap-4">
          <nav class="hidden md:flex items-center gap-5 text-sm font-medium text-slate-600 dark:text-slate-400">
            <a href={isPt ? "/pt" : isEs ? "/es" : isEn ? "/en" : "/"} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
              {isPt ? "Cursos" : isEs ? "Cursos" : isEn ? "Courses" : "강의 목록"}
            </a>
            <a href={isPt ? "/pt/news" : isEs ? "/es/news" : isEn ? "/en/news" : "/news"} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors flex items-center gap-1.5">
              <span>{isPt ? "Notícias IA" : isEs ? "Noticias IA" : isEn ? "AI News" : "정오의 AI 뉴스"}</span>
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            </a>
            <a href={isPt ? "/pt/special" : isEs ? "/es/special" : isEn ? "/en/special" : "/special"} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
              Matt's Find
            </a>
            <a href={isPt ? "/pt#curation-standard" : isEs ? "/es#curation-standard" : isEn ? "/en#curation-standard" : "/#curation-standard"} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
              {isPt ? "Critérios" : isEs ? "Criterios" : isEn ? "Criteria" : "추천 원칙"}
            </a>
            <a href={isPt ? "/pt/about" : isEs ? "/es/about" : isEn ? "/en/about" : "/about"} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
              {isPt ? "Sobre" : isEs ? "Acerca de" : isEn ? "About" : "블로그 소개"}
            </a>
            <a href={isPt ? "/pt/privacy" : isEs ? "/es/privacy" : isEn ? "/en/privacy" : "/privacy"} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
              {isPt ? "Privacidade" : isEs ? "Privacidad" : isEn ? "Privacy" : "개인정보처리방침"}
            </a>
          </nav>

          <!-- 4개국어(KO | EN | ES | PT) 세그먼트 전환 토글 -->
          <div class="inline-flex items-center rounded-xl p-0.5 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-bold shadow-2xs">
            <a href={koPath} class={`px-1.5 sm:px-2 py-1 rounded-lg transition-all ${isKo ? 'bg-blue-600 text-white shadow-xs' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'}`} title="한국어">KO</a>
            <a href={enPath} class={`px-1.5 sm:px-2 py-1 rounded-lg transition-all ${isEn ? 'bg-blue-600 text-white shadow-xs' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'}`} title="English">EN</a>
            <a href={esPath} class={`px-1.5 sm:px-2 py-1 rounded-lg transition-all ${isEs ? 'bg-blue-600 text-white shadow-xs' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'}`} title="Español">ES</a>
            <a href={ptPath} class={`px-1.5 sm:px-2 py-1 rounded-lg transition-all ${isPt ? 'bg-blue-600 text-white shadow-xs' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'}`} title="Português">PT</a>
          </div>

          <!-- 다크 모드 토글 버튼 -->
          <button
            id="theme-toggle"
            type="button"
            class="p-2 rounded-xl text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white bg-slate-100 dark:bg-slate-800/80 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all"
            aria-label="Theme toggle"
          >
            <!-- 해 아이콘 -->
            <svg id="theme-toggle-sun" class="w-4 h-4 hidden dark:block text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <!-- 달 아이콘 -->
            <svg id="theme-toggle-moon" class="w-4 h-4 block dark:hidden text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.03 9.03 0 008.354-5.646z" />
            </svg>
          </button>

          <!-- 모바일 전용 햄버거 메뉴 버튼 -->
          <button
            id="mobile-menu-toggle"
            type="button"
            class="md:hidden p-2 rounded-xl text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white bg-slate-100 dark:bg-slate-800/80 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all"
            aria-label="Toggle menu"
          >
            <svg id="hamburger-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="close-icon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- 모바일 드롭다운 메뉴 -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-950/95 backdrop-blur-md px-4 py-3 space-y-1 shadow-lg transition-all">
        <!-- 모바일 언어 선택 바 -->
        <div class="flex items-center justify-between pb-2 mb-2 border-b border-slate-100 dark:border-slate-800">
          <span class="text-xs font-bold text-slate-400">Language / Idioma:</span>
          <div class="inline-flex items-center rounded-xl p-0.5 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-bold">
            <a href={koPath} class={`px-2 py-1 rounded-lg transition-all ${isKo ? 'bg-blue-600 text-white' : 'text-slate-600 dark:text-slate-400'}`}>KO</a>
            <a href={enPath} class={`px-2 py-1 rounded-lg transition-all ${isEn ? 'bg-blue-600 text-white' : 'text-slate-600 dark:text-slate-400'}`}>EN</a>
            <a href={esPath} class={`px-2 py-1 rounded-lg transition-all ${isEs ? 'bg-blue-600 text-white' : 'text-slate-600 dark:text-slate-400'}`}>ES</a>
            <a href={ptPath} class={`px-2 py-1 rounded-lg transition-all ${isPt ? 'bg-blue-600 text-white' : 'text-slate-600 dark:text-slate-400'}`}>PT</a>
          </div>
        </div>

        <a href={isPt ? "/pt" : isEs ? "/es" : isEn ? "/en" : "/"} class="mobile-nav-link flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-800 dark:text-slate-200 hover:bg-blue-50 dark:hover:bg-slate-800 hover:text-blue-600 transition-colors">
          <span>📚</span>
          <span>{isPt ? "Todos os Cursos" : isEs ? "Todos los Cursos" : isEn ? "All Courses" : "전체 강의 목록"}</span>
        </a>
        <a href={isPt ? "/pt/news" : isEs ? "/es/news" : isEn ? "/en/news" : "/news"} class="mobile-nav-link flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-800 dark:text-slate-200 hover:bg-blue-50 dark:hover:bg-slate-800 hover:text-blue-600 transition-colors">
          <span>☀️</span>
          <span>{isPt ? "Notícias IA ao Meio-Dia" : isEs ? "Noticias IA al Mediodía" : isEn ? "AI Daily News" : "정오의 AI 뉴스 (매일 12시)"}</span>
        </a>
        <a href={isPt ? "/pt/special" : isEs ? "/es/special" : isEn ? "/en/special" : "/special"} class="mobile-nav-link flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-800 dark:text-slate-200 hover:bg-blue-50 dark:hover:bg-slate-800 hover:text-blue-600 transition-colors">
          <span>🔎</span>
          <span>Matt's Find</span>
        </a>
        <a href={isPt ? "/pt#curation-standard" : isEs ? "/es#curation-standard" : isEn ? "/en#curation-standard" : "/#curation-standard"} class="mobile-nav-link flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-800 dark:text-slate-200 hover:bg-blue-50 dark:hover:bg-slate-800 hover:text-blue-600 transition-colors">
          <span>💡</span>
          <span>{isPt ? "Critérios de Curadoria" : isEs ? "Criterios de Curaduría" : isEn ? "Curation Criteria" : "추천 원칙"}</span>
        </a>
        <a href={isPt ? "/pt/about" : isEs ? "/es/about" : isEn ? "/en/about" : "/about"} class="mobile-nav-link flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-800 dark:text-slate-200 hover:bg-blue-50 dark:hover:bg-slate-800 hover:text-blue-600 transition-colors">
          <span>👤</span>
          <span>{isPt ? "Sobre o Blog" : isEs ? "Acerca del Blog" : isEn ? "About Blogger" : "블로그 소개 & 운영자 노트"}</span>
        </a>
        <a href={isPt ? "/pt/privacy" : isEs ? "/es/privacy" : isEn ? "/en/privacy" : "/privacy"} class="mobile-nav-link flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-800 dark:text-slate-200 hover:bg-blue-50 dark:hover:bg-slate-800 hover:text-blue-600 transition-colors">
          <span>🔒</span>
          <span>{isPt ? "Política de Privacidade" : isEs ? "Política de Privacidad" : isEn ? "Privacy Policy" : "개인정보처리방침"}</span>
        </a>
        <div class="pt-2 border-t border-slate-100 dark:border-slate-800/80">
          <a href="mailto:matthew.lee.dev7@gmail.com" class="flex items-center gap-2 px-3 py-2 text-xs font-medium text-blue-600 dark:text-blue-400 hover:underline">
            <span>✉️</span>
            <span>matthew.lee.dev7@gmail.com</span>
          </a>
        </div>
      </div>
    </header>

    <!-- 본문 내용 -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- 푸터 -->
    <footer class="mt-20 border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 py-12 text-sm text-slate-500 dark:text-slate-400">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
          <div class="md:col-span-2">
            <div class="flex items-center gap-2 font-bold text-slate-900 dark:text-white text-base">
              <div class="w-6 h-6 rounded-lg bg-blue-600 flex items-center justify-center text-white text-xs">AI</div>
              {isPt ? "AI Learning Log (Português)" : isEs ? "AI Learning Log (Español)" : isEn ? "AI Learning Log" : "AI 러닝로그 (AI Learning Log)"}
            </div>
            <p class="mt-2.5 text-xs leading-relaxed max-w-md text-slate-500 dark:text-slate-400">
              {isPt
                ? "Um registro de aprendizado pessoal dedicado a curar e avaliar os melhores cursos gratuitos de IA da OpenAI, Google, Anthropic e criadores mundiais. Sem cobranças ocultas."
                : isEs
                ? "Un registro de aprendizaje personal dedicado a curar y reseñar los mejores cursos gratuitos de IA de OpenAI, Google, Anthropic y creadores mundiales. Sin muros de pago."
                : isEn 
                ? "A personal learning log dedicated to curating and reviewing top-tier free AI courses from OpenAI, Google, Anthropic, and trusted creators worldwide. Skip expensive paywalls."
                : "비싼 유료 강의 대신, 글로벌 테크 기업(OpenAI, Google, Anthropic 등)과 유명 유튜브 채널에서 공개한 양질의 무료 AI 강의를 직접 공부해보고 엄선하여 기록하는 개인 블로그입니다."}
            </p>
          </div>

          <div>
            <h4 class="font-semibold text-slate-900 dark:text-white text-xs tracking-wider uppercase mb-3">
              {isPt ? "Menu" : isEs ? "Menú" : isEn ? "Menu" : "메뉴"}
            </h4>
            <ul class="space-y-2 text-xs">
              <li><a href={isPt ? "/pt" : isEs ? "/es" : isEn ? "/en" : "/"} class="hover:text-blue-600 dark:hover:text-blue-400">{isPt ? "Todos os Cursos" : isEs ? "Todos los Cursos" : isEn ? "All Courses" : "전체 강의 목록"}</a></li>
              <li><a href={isPt ? "/pt/news" : isEs ? "/es/news" : isEn ? "/en/news" : "/news"} class="hover:text-blue-600 dark:hover:text-blue-400">{isPt ? "Notícias de IA" : isEs ? "Noticias de IA" : isEn ? "AI Daily News" : "정오의 AI 뉴스 (매일 브리핑)"}</a></li>
              <li><a href={isPt ? "/pt/about" : isEs ? "/es/about" : isEn ? "/en/about" : "/about"} class="hover:text-blue-600 dark:hover:text-blue-400">{isPt ? "Sobre o Blog" : isEs ? "Acerca del Blog" : isEn ? "About Blogger" : "블로그 소개 & 운영자 노트"}</a></li>
              <li><a href={isPt ? "/pt/privacy" : isEs ? "/es/privacy" : isEn ? "/en/privacy" : "/privacy"} class="hover:text-blue-600 dark:hover:text-blue-400">{isPt ? "Política de Privacidade" : isEs ? "Política de Privacidad" : isEn ? "Privacy Policy" : "개인정보처리방침"}</a></li>
            </ul>
          </div>

          <div>
            <h4 class="font-semibold text-slate-900 dark:text-white text-xs tracking-wider uppercase mb-3">
              {isPt ? "Contato e Sugestões" : isEs ? "Contacto y Sugerencias" : isEn ? "Feedback & Submissions" : "피드백 & 강의 제보"}
            </h4>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
              {isPt
                ? "Tem alguma recomendação de curso gratuito de IA ou sugestão? Envie uma mensagem a qualquer momento."
                : isEs
                ? "¿Tienes una recomendación de curso gratuito de IA o sugerencia? Escríbenos en cualquier momento."
                : isEn 
                ? "Have a great free AI course recommendation or feedback? Feel free to email me anytime."
                : "추천하고 싶은 무료 AI 강의가 있거나 문의사항이 있으시면 언제든 메일로 보내주세요."}
            </p>
            <a href="mailto:matthew.lee.dev7@gmail.com" class="mt-2 inline-block text-xs text-blue-600 dark:text-blue-400 font-medium hover:underline">
              matthew.lee.dev7@gmail.com
            </a>
          </div>
        </div>

        <div class="pt-8 border-t border-slate-100 dark:border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
          <p>© 2026 AI Learning Log. {isPt ? "Todos os direitos reservados." : isEs ? "Todos los derechos reservados." : "All rights reserved."}</p>
          <div class="flex items-center gap-4">
            <a href={isPt ? "/pt/privacy" : isEs ? "/es/privacy" : isEn ? "/en/privacy" : "/privacy"} class="hover:underline">{isPt ? "Privacidade" : isEs ? "Privacidad" : isEn ? "Privacy Policy" : "개인정보처리방침"}</a>
            <span>•</span>
            <a href={isPt ? "/pt/about" : isEs ? "/es/about" : isEn ? "/en/about" : "/about"} class="hover:underline">{isPt ? "Sobre" : isEs ? "Acerca de" : isEn ? "About" : "블로그 소개"}</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- 테마 토글 및 모바일 메뉴 스크립트 -->
    <script is:inline>
      const themeToggleBtn = document.getElementById('theme-toggle');
      themeToggleBtn?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });

      const mobileToggleBtn = document.getElementById('mobile-menu-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      const hamburgerIcon = document.getElementById('hamburger-icon');
      const closeIcon = document.getElementById('close-icon');

      mobileToggleBtn?.addEventListener('click', () => {
        const isHidden = mobileMenu?.classList.toggle('hidden');
        if (isHidden) {
          hamburgerIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
        } else {
          hamburgerIcon?.classList.add('hidden');
          closeIcon?.classList.remove('hidden');
        }
      });

      document.querySelectorAll('.mobile-nav-link').forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu?.classList.add('hidden');
          hamburgerIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
        });
      });
    </script>
    <Analytics />
  </body>
</html>
