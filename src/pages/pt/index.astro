---
import Layout from '../../layouts/Layout.astro';
import CourseCard from '../../components/CourseCard.astro';
import AdSenseBanner from '../../components/AdSenseBanner.astro';
import { getCollection } from 'astro:content';

const allCourses = await getCollection('courses_pt');
const sortedCourses = allCourses.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime();
});

const providers = ["Todos", "Google", "Harvard University", "DeepLearning.AI", "Stanford University", "Hugging Face", "Microsoft", "AWS"];
const levels = ["Todos", "Iniciante", "Intermediário", "Avançado"];
---

<Layout 
  title="Início | Melhores Cursos Gratuitos de IA (2026)"
  description="Coleção selecionada dos melhores cursos oficiais e gratuitos de Inteligência Artificial, engenharia de prompts e LLMs do Google, Harvard, OpenAI e líderes globais."
  lang="pt"
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 pb-16 md:pt-20 md:pb-24 border-b border-slate-200/80 dark:border-slate-800/80 bg-gradient-to-b from-blue-50/50 via-transparent to-transparent dark:from-blue-950/20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800/50 mb-6">
        <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
        Cursos Gratuitos de IA Selecionados 2026
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white max-w-3xl mx-auto leading-tight sm:leading-tight">
        Evite Bootcamps Caros, <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 bg-clip-text text-transparent">
          Aprenda com Cursos Oficiais e Gratuitos
        </span>
      </h1>

      <p class="mt-5 text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed">
        De Harvard CS50 e Google Cloud a Andrew Ng e Hugging Face.<br class="hidden sm:inline" />
        Recursos formativos verificados e dicas de estudo para autodidatas em um só lugar.
      </p>

      <!-- Key Stats -->
      <div class="mt-8 grid grid-cols-3 max-w-md mx-auto gap-4 p-4 rounded-2xl bg-white/80 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 backdrop-blur-sm shadow-sm">
        <div>
          <div class="text-xl sm:text-2xl font-black text-blue-600 dark:text-blue-400">{sortedCourses.length}+</div>
          <div class="text-[11px] sm:text-xs text-slate-500 mt-0.5">Cursos Selecionados</div>
        </div>
        <div class="border-x border-slate-100 dark:border-slate-800">
          <div class="text-xl sm:text-2xl font-black text-emerald-600 dark:text-emerald-400">100%</div>
          <div class="text-[11px] sm:text-xs text-slate-500 mt-0.5">Acesso Gratuito</div>
        </div>
        <div>
          <div class="text-xl sm:text-2xl font-black text-amber-500">4.9★</div>
          <div class="text-[11px] sm:text-xs text-slate-500 mt-0.5">Avaliação Média</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Top AdSense Banner -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-6">
    <AdSenseBanner format="horizontal" />
  </div>

  <!-- Search & Filter Controls -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-8">
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-sm space-y-4">
      <!-- Search Input -->
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input 
          type="text" 
          id="search-input" 
          placeholder="Buscar por título, plataforma, palavras-chave (ex. Python, RAG, Colab)..." 
          class="w-full pl-11 pr-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
        />
      </div>

      <!-- Filters -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pt-2 border-t border-slate-100 dark:border-slate-800">
        <!-- Provider Filters -->
        <div class="overflow-x-auto pb-1 scrollbar-none -mx-1 px-1">
          <div class="flex items-center gap-1.5 min-w-max">
            <span class="text-xs font-semibold text-slate-400 mr-1 shrink-0">Plataforma:</span>
            {providers.map((p, idx) => (
              <button 
                type="button" 
                class={`filter-provider-btn px-3 py-1.5 text-xs font-medium rounded-lg whitespace-nowrap transition-all ${
                  idx === 0 
                    ? 'bg-blue-600 text-white shadow-sm' 
                    : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700'
                }`}
                data-provider={p === "Todos" ? "ALL" : p}
              >
                {p}
              </button>
            ))}
          </div>
        </div>

        <!-- Level & Certificate Filters -->
        <div class="flex flex-wrap items-center gap-3 shrink-0">
          <!-- Level Select Buttons -->
          <div class="flex items-center gap-1 bg-slate-50 dark:bg-slate-800/50 p-1 rounded-xl border border-slate-200/80 dark:border-slate-700/80">
            {levels.map((lvl, idx) => (
              <button 
                type="button" 
                class={`filter-level-btn px-2.5 py-1 text-xs font-medium rounded-lg transition-all ${
                  idx === 0 
                    ? 'bg-slate-800 text-white dark:bg-slate-200 dark:text-slate-900 shadow-2xs' 
                    : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'
                }`}
                data-level={lvl === "Todos" ? "ALL" : lvl}
              >
                {lvl}
              </button>
            ))}
          </div>

          <!-- Certificate Toggle -->
          <label class="flex items-center gap-2 text-xs font-medium text-slate-600 dark:text-slate-300 cursor-pointer select-none bg-slate-50 dark:bg-slate-800/50 px-3 py-2 rounded-xl border border-slate-200/80 dark:border-slate-700/80 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
            <input type="checkbox" id="filter-cert-toggle" class="rounded text-blue-600 focus:ring-blue-500 w-3.5 h-3.5" />
            <span>Apenas com Certificado/Badge</span>
          </label>

          <!-- Reset Button -->
          <button 
            type="button" 
            id="reset-filters-btn"
            class="text-xs font-medium text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors px-1"
          >
            Limpar
          </button>
        </div>
      </div>
    </div>

    <!-- Active Filter Status Bar -->
    <div class="mt-4 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 px-1">
      <div id="filter-status-text">
        Exibindo <span id="result-count" class="font-bold text-slate-800 dark:text-slate-200">{sortedCourses.length}</span> cursos selecionados
      </div>
    </div>
  </section>

  <!-- Courses Grid -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-6">
    <div id="course-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedCourses.map((c) => (
        <div 
          class="course-card-wrapper"
          data-title={c.data.title.toLowerCase()}
          data-description={c.data.description.toLowerCase()}
          data-provider={c.data.provider}
          data-level={c.data.level}
          data-certificate={c.data.hasCertificate ? "true" : "false"}
          data-tags={c.data.tags.join(" ").toLowerCase()}
        >
          <CourseCard id={c.id} course={c.data} lang="pt" />
        </div>
      ))}
    </div>

    <!-- No Results Fallback -->
    <div id="no-results" class="hidden text-center py-16 px-4 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 mt-6">
      <div class="text-4xl mb-3">🔍</div>
      <h3 class="text-lg font-bold text-slate-800 dark:text-slate-200">Nenhum curso encontrado</h3>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Tente ajustar seus termos de busca ou filtros.</p>
    </div>
  </section>

  <!-- Middle AdSense Banner -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-12">
    <AdSenseBanner format="horizontal" />
  </div>

  <!-- Curation Standards -->
  <section id="curation-standard" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-16 scroll-mt-20">
    <div class="rounded-3xl border border-slate-200/80 dark:border-slate-800/80 bg-white/50 dark:bg-slate-900/50 backdrop-blur-sm p-8 sm:p-10">
      <div class="max-w-2xl">
        <span class="text-xs font-bold text-blue-600 dark:text-blue-400 tracking-wider uppercase">Nosso Compromisso</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1">
          Nossos 3 Critérios de Curadoria
        </h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
          Garantimos a seleção de recursos formativos transparentes, de alto valor acadêmico e sem cobranças ocultas.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-2xs">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-lg mb-4">
            01
          </div>
          <h3 class="font-bold text-slate-900 dark:text-white text-base">Zero Barreiras Ocultas de Pagamento</h3>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">
            Rejeitamos cursos que exigem assinaturas após duas aulas gratuitas. Todos os cursos listados são 100% acessíveis e gratuitos.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-2xs">
          <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-lg mb-4">
            02
          </div>
          <h3 class="font-bold text-slate-900 dark:text-white text-base">Instituições e Criadores de Referência</h3>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">
            Priorizamos formações oficiais dos maiores laboratórios de IA e universidades do mundo (Harvard, Google, DeepLearning.AI, Stanford).
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-2xs">
          <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold text-lg mb-4">
            03
          </div>
          <h3 class="font-bold text-slate-900 dark:text-white text-base">Executável e com Código Prático</h3>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">
            Damos preferência a cursos com cadernos Google Colab, repositórios de código aberto no GitHub e laboratórios práticos.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Client-Side Filter & Search Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('search-input');
      const providerBtns = document.querySelectorAll('.filter-provider-btn');
      const levelBtns = document.querySelectorAll('.filter-level-btn');
      const certCheckbox = document.getElementById('filter-cert-toggle');
      const resetBtn = document.getElementById('reset-filters-btn');
      const courseWrappers = document.querySelectorAll('.course-card-wrapper');
      const resultCount = document.getElementById('result-count');
      const noResults = document.getElementById('no-results');
      const tagPills = document.querySelectorAll('.tag-pill');

      let currentProvider = 'ALL';
      let currentLevel = 'ALL';
      let certificateOnly = false;
      let searchQuery = '';

      const normalize = (str) => (str || '').normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();

      function filterCourses() {
        let visibleCount = 0;
        const normQuery = normalize(searchQuery);

        courseWrappers.forEach((el) => {
          const title = el.getAttribute('data-title') || '';
          const desc = el.getAttribute('data-description') || '';
          const provider = el.getAttribute('data-provider') || '';
          const level = el.getAttribute('data-level') || '';
          const hasCert = el.getAttribute('data-certificate') === 'true';
          const tags = el.getAttribute('data-tags') || '';

          // 1. Search Query
          const matchesSearch = !normQuery || 
            normalize(title).includes(normQuery) || 
            normalize(desc).includes(normQuery) || 
            normalize(provider).includes(normQuery) ||
            normalize(tags).includes(normQuery);

          // 2. Provider Filter
          const matchesProvider = currentProvider === 'ALL' || provider.toLowerCase().includes(currentProvider.toLowerCase());

          // 3. Level Filter
          const matchesLevel = currentLevel === 'ALL' || level.toLowerCase().includes(currentLevel.toLowerCase());

          // 4. Certificate Filter
          const matchesCert = !certificateOnly || hasCert;

          if (matchesSearch && matchesProvider && matchesLevel && matchesCert) {
            el.classList.remove('hidden');
            visibleCount++;
          } else {
            el.classList.add('hidden');
          }
        });

        if (resultCount) resultCount.textContent = visibleCount.toString();
        if (noResults) {
          if (visibleCount === 0) {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }
      }

      // Search input event
      searchInput?.addEventListener('input', (e) => {
        searchQuery = e.target.value.trim();
        filterCourses();
      });

      // Provider filter
      providerBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          providerBtns.forEach(b => {
            b.classList.remove('bg-blue-600', 'text-white', 'shadow-sm');
            b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
          });
          btn.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
          btn.classList.add('bg-blue-600', 'text-white', 'shadow-sm');

          currentProvider = btn.getAttribute('data-provider') || 'ALL';
          filterCourses();
        });
      });

      // Level filter
      levelBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          levelBtns.forEach(b => {
            b.classList.remove('bg-slate-800', 'text-white', 'dark:bg-slate-200', 'dark:text-slate-900');
            b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
          });
          btn.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
          btn.classList.add('bg-slate-800', 'text-white', 'dark:bg-slate-200', 'dark:text-slate-900');

          currentLevel = btn.getAttribute('data-level') || 'ALL';
          filterCourses();
        });
      });

      // Certificate checkbox
      certCheckbox?.addEventListener('change', (e) => {
        certificateOnly = e.target.checked;
        filterCourses();
      });

      // Tag click to search
      tagPills.forEach(pill => {
        pill.addEventListener('click', () => {
          const tag = pill.textContent.replace('#', '').trim();
          if (searchInput) {
            searchInput.value = tag;
            searchQuery = tag;
            filterCourses();
            searchInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        });
      });

      // Reset filters
      resetBtn?.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        currentProvider = 'ALL';
        currentLevel = 'ALL';
        certificateOnly = false;
        if (certCheckbox) certCheckbox.checked = false;

        providerBtns.forEach((b, idx) => {
          if (idx === 0) {
            b.classList.add('bg-blue-600', 'text-white', 'shadow-sm');
            b.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
          } else {
            b.classList.remove('bg-blue-600', 'text-white', 'shadow-sm');
            b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
          }
        });

        levelBtns.forEach((b, idx) => {
          if (idx === 0) {
            b.classList.add('bg-slate-800', 'text-white', 'dark:bg-slate-200', 'dark:text-slate-900');
            b.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
          } else {
            b.classList.remove('bg-slate-800', 'text-white', 'dark:bg-slate-200', 'dark:text-slate-900');
            b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
          }
        });

        filterCourses();
      });
    });
  </script>
</Layout>
