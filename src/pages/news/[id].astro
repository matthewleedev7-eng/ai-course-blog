---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AdSenseBanner from '../../components/AdSenseBanner.astro';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const dateObj = new Date(item.data.date);
const formattedDate = dateObj.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  weekday: 'long'
});
---

<Layout
  title={`${item.data.title} | AI 러닝로그`}
  description={item.data.description}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-10">
    <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6">
      <a href="/" class="hover:text-blue-600 transition-colors">홈</a>
      <span>/</span>
      <a href="/news" class="hover:text-blue-600 transition-colors">정오의 AI 뉴스</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-medium truncate max-w-xs">{item.data.edition}</span>
    </nav>

    <header class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-10 shadow-sm mb-8">
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 dark:text-white leading-tight mb-4">
        {item.data.title}
      </h1>
      <div class="flex flex-wrap items-center gap-3 text-sm text-slate-600 dark:text-slate-400">
        <span class="px-3 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium">
          {item.data.edition}
        </span>
        <span>{formattedDate}</span>
      </div>
      <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        {item.data.description}
      </p>
    </header>

    <div class="space-y-8">
      {item.data.items.map((newsItem: any, index: number) => (
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-8 shadow-sm">
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <span class="px-3 py-1 text-xs font-bold rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
              {newsItem.category}
            </span>
            <a
              href={newsItem.sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-medium text-blue-600 dark:text-blue-400 hover:underline"
            >
              {newsItem.source} ↗
            </a>
          </div>

          <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white mb-3 leading-tight">
            {newsItem.headline}
          </h2>

          <div class="mb-4 space-y-2">
            <h3 class="text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wide">📋 요약</h3>
            <div class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed space-y-2">
              {newsItem.summary.map((point: string) => (
                <p>• {point}</p>
              ))}
            </div>
          </div>

          <div class="mb-4 p-3 rounded-lg bg-blue-50 dark:bg-blue-950/30 border border-blue-200 dark:border-blue-900/30">
            <h3 class="text-xs font-semibold text-blue-900 dark:text-blue-300 uppercase tracking-wide mb-2">💡 핵심 인사이트</h3>
            <p class="text-sm text-blue-800 dark:text-blue-200">
              {newsItem.takeaway}
            </p>
          </div>

          <div class="flex flex-wrap gap-2 mb-4">
            {newsItem.tags.map((tag: string) => (
              <span class="px-2 py-1 text-xs bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 rounded-full">
                #{tag}
              </span>
            ))}
          </div>

          {newsItem.relatedCourse && (
            <div class="p-3 rounded-lg bg-purple-50 dark:bg-purple-950/30 border border-purple-200 dark:border-purple-900/30">
              <h4 class="text-xs font-semibold text-purple-900 dark:text-purple-300 mb-1">📚 관련 강의</h4>
              <a
                href={newsItem.relatedCourse.url}
                class="text-sm text-purple-700 dark:text-purple-300 font-medium hover:underline"
              >
                {newsItem.relatedCourse.title}
              </a>
            </div>
          )}
        </div>
      ))}
    </div>

    <AdSenseBanner format="in-article" className="my-8" />

    <div class="mt-8 flex items-center justify-between gap-4">
      <a href="/news" class="text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-blue-600">← 뉴스 목록으로</a>
      <button
        id="copy-link-btn"
        type="button"
        class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-slate-700 dark:text-slate-300 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg shadow-sm hover:bg-slate-50 dark:hover:bg-slate-700 transition-all"
      >
        <span id="copy-text">페이지 링크 복사</span>
      </button>
    </div>
  </article>

  <script is:inline>
    const copyBtn = document.getElementById('copy-link-btn');
    const copyText = document.getElementById('copy-text');
    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        if (copyText) {
          copyText.textContent = '복사 완료! 🎉';
          setTimeout(() => { copyText.textContent = '페이지 링크 복사'; }, 2000);
        }
      } catch (err) {
        alert('주소가 복사되었습니다.');
      }
    });
  </script>
</Layout>
