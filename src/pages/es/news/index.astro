---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allNews = await getCollection('news_es');
// Sort by date descending (newest first)
const sortedNews = allNews.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const latestDate = sortedNews[0]?.data.date || '2026-09-01';

const categories = ["Todos", "🤖 Modelos/Herramientas", "⚡ Desarrollo/API", "🎓 Cursos Gratuitos", "🌐 Ecosistema"];
---

<Layout 
  title="Noticias de IA al Mediodía | AI Learning Log"
  description="Mantente a la vanguardia con resúmenes de 3 minutos sobre avances globales de IA, enlaces a fuentes originales y cursos gratuitos recomendados."
  lang="es"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header Section -->
    <header class="text-center py-6 sm:py-8 border-b border-slate-200 dark:border-slate-800">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-blue-100 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800/60 mb-4">
        <span>☀️</span>
        <span id="current-edition-badge">Boletín Diario de IA • {sortedNews[0]?.data.edition}</span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight flex items-center justify-center gap-2.5 flex-wrap">
        <span>Noticias de IA al Mediodía</span>
        <span id="current-title-date" class="text-blue-600 dark:text-blue-400 font-extrabold text-xl sm:text-3xl">
          · {latestDate}
        </span>
      </h1>

      <p class="mt-3 text-sm sm:text-base text-slate-600 dark:text-slate-300 max-w-xl mx-auto leading-relaxed">
        Mantente informado en <strong>3 minutos</strong> con resúmenes seleccionados del mundo de la IA.<br class="hidden sm:inline" />
        Fuentes directas verificadas, puntos clave y recomendaciones de cursos oficiales.
      </p>

      <div class="mt-4 inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-slate-100 dark:bg-slate-800/80 text-xs text-slate-500 dark:text-slate-400 font-medium">
        <span>🕒</span>
        <span id="current-pub-timestamp">Publicado: {latestDate} 12:00:00 KST</span>
      </div>
    </header>

    <!-- Search & Filter Controls -->
    <div class="mt-8 space-y-4">
      <!-- 1. Search Bar -->
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input 
          type="text" 
          id="news-search-input"
          placeholder="Buscar noticias en el archivo (ej. Claude, Gemini, RAG, Python)..." 
          class="w-full pl-11 pr-4 py-3 rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent shadow-xs transition-all"
        />
      </div>

      <!-- 2. Date Selector -->
      <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none -mx-1 px-1">
        <span class="text-xs font-bold text-slate-400 mr-1 shrink-0 flex items-center gap-1">
          <span>📅</span>
          <span>Fecha:</span>
        </span>
        {sortedNews.map((news, idx) => (
          <button 
            type="button" 
            class={`date-filter-btn px-4 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition-all ${
              idx === 0 
                ? 'bg-blue-600 text-white shadow-sm ring-2 ring-blue-500/20' 
                : 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700'
            }`}
            data-date={news.data.date}
            data-edition={news.data.edition}
          >
            {news.data.date}
          </button>
        ))}
        <button 
          type="button" 
          class="date-filter-btn px-4 py-2 rounded-xl text-xs font-bold whitespace-nowrap bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all"
          data-date="ALL"
          data-edition="Todos los Archivos"
        >
          📂 Ver Todos los Archivos
        </button>
      </div>

      <!-- 3. Category Filter Chips -->
      <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none -mx-1 px-1">
        <span class="text-xs font-bold text-slate-400 mr-1 shrink-0">Categoría:</span>
        {categories.map((cat, idx) => (
          <button 
            type="button" 
            class={`category-filter-btn px-3 py-1 text-xs font-medium rounded-lg whitespace-nowrap transition-all ${
              idx === 0 
                ? 'bg-blue-600 text-white shadow-xs' 
                : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700'
            }`}
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <!-- News Cards Container -->
    <section class="mt-8 space-y-6" id="news-list-container">
      {sortedNews.map((newsBlock) => (
        newsBlock.data.items.map((item, index) => (
          <article 
            class="news-card rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-8 shadow-sm hover:border-blue-500/40 transition-all overflow-hidden"
            data-date={newsBlock.data.date}
            data-category={item.category}
            data-title={item.headline.toLowerCase()}
            data-summary={item.summary.join(' ').toLowerCase()}
            data-tags={item.tags.join(' ').toLowerCase()}
            style={newsBlock.data.date === latestDate ? "" : "display: none;"}
          >
            <!-- Meta Bar -->
            <div class="flex items-center justify-between gap-2 flex-wrap mb-3.5">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 border border-blue-100 dark:border-blue-900/50">
                  {item.category}
                </span>
                <span class="text-xs font-medium text-slate-500 dark:text-slate-400">
                  Fuente: <strong>{item.source}</strong>
                </span>
                {item.publishedDate && (
                  <span class="text-xs text-slate-400 dark:text-slate-500 flex items-center gap-1">
                    <span>•</span>
                    <span>Fecha: <strong class="text-slate-600 dark:text-slate-300">{item.publishedDate}</strong></span>
                  </span>
                )}
              </div>

              <!-- Source Link -->
              <a 
                href={item.sourceUrl} 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 px-3 py-1 rounded-lg text-xs font-semibold text-blue-600 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-950/40 transition-colors"
              >
                <span>Leer Artículo Original</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>

            <!-- Headline -->
            <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white leading-snug">
              <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 transition-colors">
                {item.headline}
              </a>
            </h2>

            <!-- Key Highlights Box -->
            <div class="mt-4 p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800/80">
              <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2 flex items-center gap-1.5">
                <span>📌</span>
                <span>Puntos Clave</span>
              </div>
              <ul class="space-y-2 text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
                {item.summary.map((line) => (
                  <li class="flex items-start gap-2">
                    <span class="text-blue-500 font-bold shrink-0 mt-0.5">•</span>
                    <span>{line}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Takeaway -->
            <div class="mt-3.5 p-3.5 rounded-xl bg-indigo-50/70 dark:bg-indigo-950/40 border border-indigo-100 dark:border-indigo-900/50 text-xs sm:text-sm text-indigo-900 dark:text-indigo-200 leading-relaxed font-medium">
              {item.takeaway}
            </div>

            <!-- Tags & Actions -->
            <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/60 flex items-center justify-between gap-2 flex-wrap">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="text-[11px] text-slate-400 font-medium mr-1">📅 Edición {newsBlock.data.date}</span>
                {item.tags.map((tag) => (
                  <span class="text-[11px] px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">
                    #{tag}
                  </span>
                ))}
              </div>

              <!-- Quick Share/Copy -->
              <button 
                type="button" 
                class="copy-news-btn inline-flex items-center gap-1 text-xs text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                data-text={`[Noticias de IA] ${item.headline} - Fuente: ${item.sourceUrl}`}
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <span>Compartir</span>
              </button>
            </div>

            <!-- Related Course Link -->
            {item.relatedCourse && (
              <div class="mt-4 p-3 rounded-xl bg-blue-50/60 dark:bg-blue-950/30 border border-blue-100 dark:border-blue-900/40 flex items-center justify-between gap-3 flex-wrap text-xs">
                <div class="flex items-center gap-2 text-slate-700 dark:text-slate-300">
                  <span class="text-sm">💡</span>
                  <span>Curso Gratuito Relacionado: <strong class="text-blue-700 dark:text-blue-300">{item.relatedCourse.title}</strong></span>
                </div>
                <a 
                  href={item.relatedCourse.url.startsWith('/es') ? item.relatedCourse.url : `/es${item.relatedCourse.url}`}
                  class="font-bold text-blue-600 dark:text-blue-400 hover:underline inline-flex items-center gap-1 shrink-0"
                >
                  <span>Ir al Curso</span>
                  <span>→</span>
                </a>
              </div>
            )}
          </article>
        ))
      ))}

      <!-- Empty State -->
      <div id="no-search-results" class="hidden py-16 text-center rounded-3xl border border-dashed border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-8">
        <div class="w-12 h-12 mx-auto rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400 mb-3">
          🔍
        </div>
        <h3 class="text-base font-bold text-slate-700 dark:text-slate-300">No se encontraron noticias coincidentes</h3>
        <p class="text-xs text-slate-400 mt-1">Prueba con otras palabras clave o selecciona otra fecha.</p>
      </div>
    </section>

    <!-- Bottom Guide Note -->
    <div class="mt-16 p-6 rounded-3xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-center">
      <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-1">
        ¿Quieres recibir noticias y cursos de IA a diario?
      </h3>
      <p class="text-xs text-slate-500 dark:text-slate-400 max-w-md mx-auto leading-relaxed">
        Publicamos noticias verificadas todos los días a las 12:00 KST. Guarda esta página en tus marcadores y acompáñanos a la hora del almuerzo.
      </p>
    </div>
  </div>

  <!-- Client Script for Interactive Filters -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('news-search-input');
      const dateBtns = document.querySelectorAll('.date-filter-btn');
      const catBtns = document.querySelectorAll('.category-filter-btn');
      const newsCards = document.querySelectorAll('.news-card');
      const noResults = document.getElementById('no-search-results');
      const titleDate = document.getElementById('current-title-date');
      const editionBadge = document.getElementById('current-edition-badge');
      const pubTimestamp = document.getElementById('current-pub-timestamp');

      let activeDate = dateBtns[0]?.getAttribute('data-date') || 'ALL';
      let activeCategory = 'Todos';
      let searchQuery = '';

      function filterCards() {
        let visibleCount = 0;

        newsCards.forEach(card => {
          const cardDate = card.getAttribute('data-date');
          const cardCat = card.getAttribute('data-category');
          const cardTitle = card.getAttribute('data-title') || '';
          const cardSummary = card.getAttribute('data-summary') || '';
          const cardTags = card.getAttribute('data-tags') || '';

          // 1. Date condition
          const dateMatch = activeDate === 'ALL' || cardDate === activeDate;

          // 2. Category condition
          const catMatch = activeCategory === 'Todos' || cardCat === activeCategory;

          // 3. Search query condition
          const queryMatch = searchQuery.length === 0 || 
            cardTitle.includes(searchQuery) || 
            cardSummary.includes(searchQuery) || 
            cardTags.includes(searchQuery);

          if (dateMatch && catMatch && queryMatch) {
            card.style.display = 'block';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (noResults) {
          if (visibleCount === 0) {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }
      }

      // Search event
      searchInput?.addEventListener('input', (e) => {
        searchQuery = e.target.value.trim().toLowerCase();
        filterCards();
      });

      // Date click
      dateBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          dateBtns.forEach(b => {
            b.classList.remove('bg-blue-600', 'text-white', 'shadow-sm', 'ring-2', 'ring-blue-500/20');
            b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
          });
          btn.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
          btn.classList.add('bg-blue-600', 'text-white', 'shadow-sm', 'ring-2', 'ring-blue-500/20');

          activeDate = btn.getAttribute('data-date') || 'ALL';
          const editionText = btn.getAttribute('data-edition') || '';

          if (titleDate) {
            titleDate.textContent = activeDate === 'ALL' ? '· Archivo Completo' : `· ${activeDate}`;
          }
          if (editionBadge) {
            editionBadge.textContent = activeDate === 'ALL' ? 'Historial Completo' : `Boletín de IA • ${editionText}`;
          }
          if (pubTimestamp) {
            pubTimestamp.textContent = activeDate === 'ALL' ? 'Mostrando todas las ediciones' : `Publicado: ${activeDate} 12:00:00 KST`;
          }

          filterCards();
        });
      });

      // Category click
      catBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          catBtns.forEach(b => {
            b.classList.remove('bg-blue-600', 'text-white', 'shadow-xs');
            b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
          });
          btn.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
          btn.classList.add('bg-blue-600', 'text-white', 'shadow-xs');

          activeCategory = btn.getAttribute('data-category') || 'Todos';
          filterCards();
        });
      });

      // Share button click
      const copyBtns = document.querySelectorAll('.copy-news-btn');
      copyBtns.forEach(btn => {
        btn.addEventListener('click', async () => {
          const text = btn.getAttribute('data-text') || '';
          try {
            await navigator.clipboard.writeText(text);
            const originalHtml = btn.innerHTML;
            btn.innerHTML = '<span>¡Copiado! ✓</span>';
            setTimeout(() => {
              btn.innerHTML = originalHtml;
            }, 2000);
          } catch (e) {
            alert('Texto copiado.');
          }
        });
      });
    });
  </script>
</Layout>
