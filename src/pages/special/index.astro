---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allSpecials = await getCollection('special');
const sorted = allSpecials.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const categories = ["전체", ...Array.from(new Set(sorted.map((item) => item.data.category)))];
---

<Layout
  title="Matt's Find | AI 러닝로그"
  description="정오의 뉴스 브리핑 형식을 넘어서는, 깊이 있는 취재와 사실관계 검증을 거친 AI 러닝로그만의 이슈 코너."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <header class="text-center py-6 sm:py-8 border-b border-slate-200 dark:border-slate-800">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-purple-100 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800/60 mb-4">
        <span>🔎</span>
        <span>깊이 있는 단독 분석</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">Matt's Find</h1>
      <p class="mt-3 text-sm sm:text-base text-slate-600 dark:text-slate-300 max-w-xl mx-auto leading-relaxed">
        매일의 정오 브리핑에 담기 힘든 굵직한 사건을,<br />
        원문 출처를 밝히고 사실관계를 검증해 깊이 있게 다룹니다.
      </p>
    </header>

    <div class="mt-8 space-y-4">
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          id="find-search-input"
          placeholder="회차, 제목, 태그로 검색 (예: 01, 인프라, 에이전트)..."
          class="w-full pl-11 pr-4 py-3 rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent shadow-xs transition-all"
        />
      </div>

      <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none -mx-1 px-1">
        <span class="text-xs font-bold text-slate-400 mr-1 shrink-0">분류:</span>
        {categories.map((cat, idx) => (
          <button
            type="button"
            class={`category-filter-btn px-3 py-1 text-xs font-medium rounded-lg whitespace-nowrap transition-all ${
              idx === 0
                ? 'bg-purple-600 text-white shadow-xs'
                : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700'
            }`}
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <section class="mt-8 space-y-6" id="find-list-container">
      {sorted.map((item) => (
        <a
          href={`/special/${item.id}`}
          class="find-card block rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-8 shadow-sm hover:border-purple-500/40 transition-all"
          data-category={item.data.category}
          data-search={`${item.data.title} ${item.data.summary} ${item.data.edition ?? ''} ${item.data.tags.join(' ')}`.toLowerCase()}
        >
          <div class="flex items-center gap-2 flex-wrap mb-3">
            <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-purple-50 dark:bg-purple-950/60 text-purple-600 dark:text-purple-400 border border-purple-100 dark:border-purple-900/50">
              {item.data.category}
            </span>
            {item.data.edition && (
              <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                {item.data.edition}
              </span>
            )}
            <span class="text-xs text-slate-400">{item.data.date}</span>
            <span class="text-xs text-slate-400">· {item.data.author}</span>
          </div>
          <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white leading-snug hover:text-purple-600 transition-colors">
            {item.data.title}
          </h2>
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-300 leading-relaxed line-clamp-3">
            {item.data.summary}
          </p>
          <div class="mt-4 flex items-center gap-1.5 flex-wrap">
            {item.data.tags.map((tag) => (
              <span class="text-[11px] px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">
                #{tag}
              </span>
            ))}
          </div>
        </a>
      ))}

      <div id="find-no-results" class="hidden py-16 text-center rounded-3xl border border-dashed border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-8">
        <div class="w-12 h-12 mx-auto rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400 mb-3">🔍</div>
        <h3 class="text-base font-bold text-slate-700 dark:text-slate-300">검색 결과가 없습니다</h3>
        <p class="text-xs text-slate-400 mt-1">다른 키워드로 검색하거나 분류를 변경해 보세요.</p>
      </div>

      {sorted.length === 0 && (
        <div class="text-center py-16 text-slate-400 text-sm">아직 등록된 Matt's Find 기사가 없습니다.</div>
      )}
    </section>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('find-search-input');
      const catBtns = document.querySelectorAll('.category-filter-btn');
      const cards = document.querySelectorAll('.find-card');
      const noResults = document.getElementById('find-no-results');

      let activeCategory = '전체';
      let searchQuery = '';

      function filterCards() {
        let visibleCount = 0;
        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-category');
          const cardSearch = card.getAttribute('data-search') || '';
          const catMatch = activeCategory === '전체' || cardCat === activeCategory;
          const queryMatch = searchQuery.length === 0 || cardSearch.includes(searchQuery);
          if (catMatch && queryMatch) {
            card.style.display = 'block';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });
        if (noResults) noResults.classList.toggle('hidden', visibleCount > 0 || cards.length === 0);
      }

      catBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          catBtns.forEach((b) => {
            b.classList.remove('bg-purple-600', 'text-white', 'shadow-xs');
            b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
          });
          btn.classList.add('bg-purple-600', 'text-white', 'shadow-xs');
          btn.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
          activeCategory = btn.getAttribute('data-category') || '전체';
          filterCards();
        });
      });

      searchInput?.addEventListener('input', (e) => {
        searchQuery = (e.target.value || '').trim().toLowerCase();
        filterCards();
      });
    });
  </script>
</Layout>
