  <script is:inline>
    // 전역 상태
    let currentDau = 100;
    let inputTokens = 500;
    let outputTokens = 800;
    let turnsPerDay = 3;
    const KRW_RATE = 1350;

    // 1M 토큰당 가격 (단위: 달러 $)
    const PRICING = {
      geminiFlash: { input: 0.075, output: 0.30 },
      gpt4oMini: { input: 0.15, output: 0.60 },
      solarPro: { input: 0.25, output: 0.80 },
      gpt4o: { input: 2.50, output: 10.00 },
      claudeSonnet: { input: 3.00, output: 15.00 },
    };

    function recalculate() {
      // 월간 총 대화 수 (30일)
      const totalMonthlyConversations = currentDau * turnsPerDay * 30;

      // 월간 총 입력 / 출력 토큰
      const totalInputTokens = totalMonthlyConversations * inputTokens;
      const totalOutputTokens = totalMonthlyConversations * outputTokens;
      const totalTokens = totalInputTokens + totalOutputTokens;

      // 상단 디스플레이 업데이트
      document.getElementById('dau-display').innerText = currentDau.toLocaleString() + ' 명';
      document.getElementById('total-tokens-display').innerText = (totalTokens / 1000000).toFixed(1) + ' M';
      document.getElementById('input-tokens-display').innerText = (totalInputTokens / 1000000).toFixed(1) + ' M';
      document.getElementById('output-tokens-display').innerText = (totalOutputTokens / 1000000).toFixed(1) + ' M';

      // 모델별 청구액 계산
      const calcModel = (key, costId, krwId) => {
        const p = PRICING[key];
        const cost = ((totalInputTokens / 1000000) * p.input) + ((totalOutputTokens / 1000000) * p.output);
        const krw = Math.round(cost * KRW_RATE);

        document.getElementById(costId).innerText = cost < 10 ? cost.toFixed(2) : cost.toFixed(1);
        document.getElementById(krwId).innerText = krw.toLocaleString();
      };

      calcModel('geminiFlash', 'cost-gemini-flash', 'krw-gemini-flash');
      calcModel('gpt4oMini', 'cost-gpt4o-mini', 'krw-gpt4o-mini');
      calcModel('solarPro', 'cost-solar-pro', 'krw-solar-pro');
      calcModel('gpt4o', 'cost-gpt4o', 'krw-gpt4o');
      calcModel('claudeSonnet', 'cost-claude-sonnet', 'krw-claude-sonnet');
    }

    document.addEventListener('DOMContentLoaded', () => {
      // 1. DAU 버튼 클릭
      const dauBtns = document.querySelectorAll('.dau-btn');
      const dauSlider = document.getElementById('dau-slider');

      dauBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          dauBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          currentDau = parseInt(btn.getAttribute('data-val'));
          dauSlider.value = currentDau;
          recalculate();
        });
      });

      // 슬라이더 조절
      dauSlider.addEventListener('input', (e) => {
        currentDau = parseInt(e.target.value);
        dauBtns.forEach(b => {
          if (parseInt(b.getAttribute('data-val')) === currentDau) {
            b.classList.add('active');
          } else {
            b.classList.remove('active');
          }
        });
        recalculate();
      });

      // 2. 드롭다운 선택
      document.getElementById('input-select').addEventListener('change', (e) => {
        inputTokens = parseInt(e.target.value);
        recalculate();
      });

      document.getElementById('output-select').addEventListener('change', (e) => {
        outputTokens = parseInt(e.target.value);
        recalculate();
      });

      document.getElementById('turns-select').addEventListener('change', (e) => {
        turnsPerDay = parseInt(e.target.value);
        recalculate();
      });

      recalculate();
    });
  </script>

