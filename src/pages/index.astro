---
import Layout from '../layouts/Layout.astro';
import CourseCard from '../components/CourseCard.astro';
import AdSenseBanner from '../components/AdSenseBanner.astro';
import { getCollection } from 'astro:content';

const allCourses = await getCollection('courses');
// featured 우선, 그 다음 최신순 정렬
const sortedCourses = allCourses.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime();
});

const providers = ["전체", "OpenAI", "Anthropic", "Google", "DeepLearning.AI", "Microsoft", "Hugging Face", "Fast.ai", "Kaggle", "YouTube"];
const levels = ["전체", "입문", "중급"];
---

<Layout 
  title="홈 | 나만 알기 아까운 무료 AI 강의 노트 (2026)"
  description="OpenAI, Anthropic Claude, 구글, 앤드류 응의 DeepLearning.AI, 캐글, 유튜브 명강의 등 실무와 독학에 바로 쓸 수 있는 무료 인공지능 강의를 엄선하여 안내합니다."
>
  <!-- 히어로 섹션 -->
  <section class="relative overflow-hidden pt-12 pb-16 md:pt-20 md:pb-24 border-b border-slate-200/80 dark:border-slate-800/80 bg-gradient-to-b from-blue-50/50 via-transparent to-transparent dark:from-blue-950/20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800/50 mb-6">
        <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
        2026 최신 무료 AI 강의 큐레이션
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white max-w-3xl mx-auto leading-tight sm:leading-tight">
        비싼 유료 강의 대신, <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 bg-clip-text text-transparent">
          글로벌 공식 무료 AI 강의
        </span>로 시작하세요
      </h1>

      <p class="mt-5 text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed">
        OpenAI Academy부터 Anthropic Claude, Google, 캐글, 유튜브 명강의까지.<br class="hidden sm:inline" />
        직접 들어보고 엄선한 고품질 무료 교육과 수강 팁을 한곳에 모았습니다.
      </p>

      <!-- 핵심 통계 지표 -->
      <div class="mt-8 grid grid-cols-3 max-w-md mx-auto gap-4 p-4 rounded-2xl bg-white/80 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 backdrop-blur-sm shadow-sm">
        <div>
          <div class="text-xl sm:text-2xl font-black text-blue-600 dark:text-blue-400">{sortedCourses.length}+</div>
          <div class="text-[11px] sm:text-xs text-slate-500 mt-0.5">선정된 강의</div>
        </div>
        <div class="border-x border-slate-100 dark:border-slate-800">
          <div class="text-xl sm:text-2xl font-black text-emerald-600 dark:text-emerald-400">100%</div>
          <div class="text-[11px] sm:text-xs text-slate-500 mt-0.5">무료 수강</div>
        </div>
        <div>
          <div class="text-xl sm:text-2xl font-black text-amber-500">4.9★</div>
          <div class="text-[11px] sm:text-xs text-slate-500 mt-0.5">평균 추천도</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 상단 애드센스 영역 -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-6">
    <AdSenseBanner format="horizontal" />
  </div>

  <!-- 검색 및 필터 바 -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-8">
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-sm space-y-4">
      <!-- 검색창 -->
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input 
          type="text" 
          id="search-input"
          placeholder="강의명, 플랫폼, 키워드(예: 프롬프트, LLM, Colab) 검색..." 
          class="w-full pl-11 pr-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
        />
      </div>

      <!-- 플랫폼 및 난이도 필터 버튼 -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pt-2 border-t border-slate-100 dark:border-slate-800">
        <!-- 제공처 필터 (모바일 터치 가로 스와이프 지원) -->
        <div class="overflow-x-auto pb-1 scrollbar-none -mx-1 px-1">
          <div class="flex items-center gap-1.5 min-w-max">
            <span class="text-xs font-semibold text-slate-400 mr-1 shrink-0">제공사:</span>
            {providers.map((p, idx) => (
              <button 
                type="button" 
                class={`filter-provider-btn px-3 py-1.5 text-xs font-medium rounded-lg whitespace-nowrap transition-all ${
                  idx === 0 
                    ? 'bg-blue-600 text-white shadow-sm' 
                    : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700'
                }`}
                data-provider={p}
              >
                {p}
              </button>
            ))}
          </div>
        </div>

        <!-- 난이도 & 수료증 옵션 -->
        <div class="flex items-center justify-between sm:justify-start gap-3 flex-wrap pt-1 sm:pt-0">
          <div class="flex items-center gap-1">
            <span class="text-xs font-semibold text-slate-400 mr-1 shrink-0">난이도:</span>
            {levels.map((lvl, idx) => (
              <button 
                type="button" 
                class={`filter-level-btn px-2.5 py-1.5 text-xs font-medium rounded-lg whitespace-nowrap transition-all ${
                  idx === 0 
                    ? 'bg-slate-800 text-white dark:bg-slate-200 dark:text-slate-900' 
                    : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700'
                }`}
                data-level={lvl}
              >
                {lvl}
              </button>
            ))}
          </div>

          <label class="inline-flex items-center gap-1.5 text-xs text-slate-600 dark:text-slate-400 cursor-pointer ml-auto sm:ml-2">
            <input type="checkbox" id="filter-certificate" class="rounded border-slate-300 dark:border-slate-700 text-blue-600 focus:ring-blue-500 w-4 h-4" />
            <span class="whitespace-nowrap">수료증/뱃지 제공만</span>
          </label>
        </div>
      </div>
    </div>
  </section>

  <!-- 강의 목록 카드 그리드 -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-8">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
        <span>추천 무료 강의</span>
        <span id="result-count" class="text-xs font-semibold px-2 py-0.5 rounded-full bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400">
          {sortedCourses.length}개
        </span>
      </h2>
    </div>

    <!-- 카드 목록 -->
    <div id="course-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedCourses.map((course) => (
        <CourseCard id={course.id} course={course.data} />
      ))}
    </div>

    <!-- 검색 결과 없음 상태 -->
    <div id="no-results" class="hidden py-16 text-center rounded-2xl border border-dashed border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-8">
      <div class="w-12 h-12 mx-auto rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400 mb-3">
        🔍
      </div>
      <h3 class="text-base font-bold text-slate-700 dark:text-slate-300">검색 조건에 맞는 강의가 없습니다</h3>
      <p class="text-xs text-slate-400 mt-1">다른 검색어나 필터를 선택해 보세요.</p>
      <button 
        id="reset-filters" 
        class="mt-4 px-4 py-1.5 text-xs font-semibold text-blue-600 bg-blue-50 dark:bg-blue-900/30 rounded-lg hover:bg-blue-100"
      >
        필터 초기화
      </button>
    </div>
  </section>

  <!-- 하단 애드센스 영역 -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-12">
    <AdSenseBanner format="in-article" />
  </div>

  <!-- 추천 기준 및 소개 섹션 (SEO 및 애드센스 고유 가치 입증) -->
  <section id="curation-standard" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-16">
    <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-gradient-to-br from-slate-50 via-white to-blue-50/30 dark:from-slate-900 dark:via-slate-900 dark:to-blue-950/20 p-8 sm:p-10">
      <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight mb-4">
        💡 AI 러닝로그의 3대 추천 원칙
      </h3>
      <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed max-w-3xl mb-8">
        인터넷에 넘쳐나는 광고성 미끼 강좌를 거르고, 학습자의 소중한 시간을 아끼기 위해 직접 검증한 3가지 기준을 고수합니다.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-5 rounded-2xl bg-white dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60 shadow-sm">
          <div class="w-9 h-9 rounded-xl bg-blue-500/10 text-blue-600 flex items-center justify-center font-bold mb-3">
            01
          </div>
          <h4 class="font-bold text-slate-900 dark:text-white text-base mb-1.5">공식 & 권위 있는 출처</h4>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            OpenAI, Google, Microsoft, Stanford 등 글로벌 테크 기업 및 연구기관의 공식 교육 과정만 수록합니다.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60 shadow-sm">
          <div class="w-9 h-9 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center font-bold mb-3">
            02
          </div>
          <h4 class="font-bold text-slate-900 dark:text-white text-base mb-1.5">숨겨진 결제 없는 완전 무료</h4>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            처음 몇 강만 무료이고 결제를 유도하는 미끼 상품을 배제하고, 핵심 내용을 끝까지 무료로 학습할 수 있는 코스만 추천합니다.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60 shadow-sm">
          <div class="w-9 h-9 rounded-xl bg-purple-500/10 text-purple-600 flex items-center justify-center font-bold mb-3">
            03
          </div>
          <h4 class="font-bold text-slate-900 dark:text-white text-base mb-1.5">실전 활용성 & 실습 환경</h4>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            단순 암기용 이론이 아니라 Colab, Jupyter 노트북, API 연동 등 손으로 직접 실습해볼 수 있는 코스를 최우선 선별합니다.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 실시간 필터링 스크립트 -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('search-input');
      const providerBtns = document.querySelectorAll('.filter-provider-btn');
      const levelBtns = document.querySelectorAll('.filter-level-btn');
      const certCheckbox = document.getElementById('filter-certificate');
      const cards = document.querySelectorAll('.course-card');
      const resultCount = document.getElementById('result-count');
      const noResults = document.getElementById('no-results');
      const resetBtn = document.getElementById('reset-filters');
      const tagPills = document.querySelectorAll('.tag-pill');

      let currentProvider = '전체';
      let currentLevel = '전체';
      let requireCert = false;
      let searchQuery = '';

      function filterCourses() {
        let visibleCount = 0;

        cards.forEach((card) => {
          const provider = card.getAttribute('data-provider');
          const level = card.getAttribute('data-level');
          const hasCert = card.getAttribute('data-certificate') === 'true';
          const searchText = card.getAttribute('data-search') || '';

          const matchProvider = currentProvider === '전체' || provider === currentProvider;
          const matchLevel = currentLevel === '전체' || level === currentLevel;
          const matchCert = !requireCert || hasCert;
          const matchSearch = !searchQuery || searchText.includes(searchQuery);

          if (matchProvider && matchLevel && matchCert && matchSearch) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (resultCount) {
          resultCount.textContent = `${visibleCount}개`;
        }

        if (noResults) {
          if (visibleCount === 0) {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }
      }

      // 검색어 입력 이벤트
      searchInput?.addEventListener('input', (e) => {
        searchQuery = e.target.value.trim().toLowerCase();
        filterCourses();
      });

      // 제공사 필터 버튼
      providerBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          providerBtns.forEach(b => {
            b.classList.remove('bg-blue-600', 'text-white', 'shadow-sm');
            b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
          });
          btn.classList.add('bg-blue-600', 'text-white', 'shadow-sm');
          btn.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
          currentProvider = btn.getAttribute('data-provider') || '전체';
          filterCourses();
        });
      });

      // 난이도 필터 버튼
      levelBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          levelBtns.forEach(b => {
            b.classList.remove('bg-slate-800', 'text-white', 'dark:bg-slate-200', 'dark:text-slate-900');
            b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
          });
          btn.classList.add('bg-slate-800', 'text-white', 'dark:bg-slate-200', 'dark:text-slate-900');
          btn.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
          currentLevel = btn.getAttribute('data-level') || '전체';
          filterCourses();
        });
      });

      // 수료증 체크박스
      certCheckbox?.addEventListener('change', (e) => {
        requireCert = e.target.checked;
        filterCourses();
      });

      // 태그 클릭 시 즉시 검색창 반영
      tagPills.forEach((tag) => {
        tag.addEventListener('click', (e) => {
          e.stopPropagation();
          const cleanTag = tag.textContent.replace('#', '').trim().toLowerCase();
          if (searchInput) {
            searchInput.value = cleanTag;
            searchQuery = cleanTag;
            filterCourses();
            searchInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        });
      });

      // 리셋 버튼
      resetBtn?.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        currentProvider = '전체';
        currentLevel = '전체';
        requireCert = false;
        if (certCheckbox) certCheckbox.checked = false;

        providerBtns.forEach((b, idx) => {
          if (idx === 0) {
            b.classList.add('bg-blue-600', 'text-white');
            b.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
          } else {
            b.classList.remove('bg-blue-600', 'text-white');
            b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
          }
        });

        levelBtns.forEach((b, idx) => {
          if (idx === 0) {
            b.classList.add('bg-slate-800', 'text-white', 'dark:bg-slate-200', 'dark:text-slate-900');
            b.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
          } else {
            b.classList.remove('bg-slate-800', 'text-white', 'dark:bg-slate-200', 'dark:text-slate-900');
            b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
          }
        });

        filterCourses();
      });
    });
  </script>
</Layout>
